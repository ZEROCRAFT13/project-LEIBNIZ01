# app/.env.local の見本（app/.env.local は git に入らない）
# DATABASE_URL と ZB_DEV_LOGIN は、リポジトリの一番上で npm run db:seed を実行すると書き込まれる。

# 開発用ログイン（npm run dev のときだけ効く。本番のビルドでは無視される）
ZB_DEV_LOGIN=1

# ---- Google ログイン（README の「ログインの準備」）----
# Google Cloud の「OAuth クライアント ID（ウェブ アプリケーション）」の値
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 会社の Google Workspace のドメイン（このドメインのアカウントだけログインできる）
AUTH_ALLOWED_DOMAIN=
# この画面のURL。Google に登録するリダイレクトURIは「APP_URL/auth/callback」
APP_URL=http://localhost:3000

# ---- 書類（npm run db:seed が、このPCのフォルダを書き込む）----
# 取り込んだ書類のファイルを置く場所（本番では Google Cloud Storage にする）
ZB_STORAGE_DIR=
# 共有の取り込みフォルダ（スキャナーの保存先・ダウンロードした領収書の置き場所）
ZB_INBOX_DIR=
