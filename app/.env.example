# app/.env.local の見本（app/.env.local は git に入らない）
# DATABASE_URL と ZB_DEV_LOGIN は、リポジトリの一番上で npm run db:seed を実行すると書き込まれる。

# 開発用ログイン（npm run dev のときだけ効く。本番のビルドでは無視される）
ZB_DEV_LOGIN=1

# ---- Google ログイン（README の「ログインの準備」）----
# Google Cloud の「OAuth クライアント ID（ウェブ アプリケーション）」の値
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 会社の Google Workspace のドメイン（このドメインのアカウントだけログインできる）
AUTH_ALLOWED_DOMAIN=
# この画面のURL。Google に登録するリダイレクトURIは「APP_URL/auth/callback」
APP_URL=http://localhost:3000

# ---- 書類（npm run db:seed が、このPCのフォルダを書き込む）----
# 取り込んだ書類のファイルを置く場所（本番では Google Cloud Storage にする）
ZB_STORAGE_DIR=
# 共有の取り込みフォルダ（スキャナーの保存先・ダウンロードした領収書の置き場所）
ZB_INBOX_DIR=

# ---- 管理番号シール ----
# シールの QR に入れる URL の頭（お客様が読むと「この URL/r/管理番号」の製品登録ページが開く）。
# 空のままだと仮の https://zerobit.example になる。お客様に渡す本物のシールを刷る前に決めること
ZB_PUBLIC_URL=

# ---- Amazon SP-API（README の「Amazon とつなぐ」）----
# ソリューションプロバイダーポータルのアプリの「LWA 認証情報」と、「アプリを承認」で出たリフレッシュトークン。
# チャットやコードには書かない。本番は Secret Manager。クライアントシークレットは180日ごとに更新が要る
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=
# 定期実行（Cloud Scheduler → /api/jobs/amazon-orders）の合言葉。32文字以上のでたらめな文字（本番で使う）
ZB_JOB_SECRET=
